# Unity .gitignore
# Place this in the REPO ROOT (the folder that contains .git and "My project"),
# and make sure it is named ".gitignore" (with the leading dot).
#
# NOTE: In gitignore, any pattern with a "/" at the start or in the middle is
# anchored to the folder containing this file. Those patterns are prefixed with
# "**/" below so they also match inside the "My project/" subfolder.

# Explicit rules for this project's folder (belt and braces)
My project/Library/
My project/Logs/
My project/Temp/
My project/Assets/_Recovery/

# Unity-generated folders (regenerated automatically)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity editor crash-recovery scenes (e.g. Assets/_Recovery/0 (4).unity)
**/[Aa]ssets/_Recovery/
**/[Aa]ssets/_Recovery.meta

# Log files anywhere
*.log

# Asset meta data should only be ignored when the corresponding asset is also ignored
!**/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# **/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code cache
.vs/
.vscode/
.idea/

# Gradle cache
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db
